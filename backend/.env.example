# Backend configuration (spec section 5). Copy to backend/.env:
#     cp .env.example .env
# This is the only dotenv file the backend reads. Values come from the
# process environment first, then from backend/.env (anchored to the backend
# directory, so the launch directory does not matter). Never commit .env.
#
# The defaults below point at the shared disposable test instance and its
# existing domain/group/traffic source, so a fresh checkout starts locally
# once KEITARO_API_KEY is filled in below.

# Keitaro Admin API (required). Must end with /admin_api/v1.
KEITARO_BASE_URL=https://keitaro-for-tests.etolegko.com/admin_api/v1

# Server-only Admin API credential. Never commit a real key.
KEITARO_API_KEY=

# Existing Keitaro IDs reused for every new campaign (required, positive integers).
# These are the domain/group/traffic source on the disposable test instance.
KEITARO_DOMAIN_ID=1813
KEITARO_GROUP_ID=10332
KEITARO_TRAFFIC_SOURCE_ID=836

# Absolute HTTPS URL used by the Google stream (required).
GOOGLE_REDIRECT_URL=https://www.google.com/

# SQLAlchemy database URL (required). Relative SQLite paths resolve from backend/.
DATABASE_URL=sqlite:///./keitaro-campaign-manager.db

# Optional: request timeout for Keitaro calls, seconds (default 30).
# KEITARO_TIMEOUT_SECONDS=30

# Optional: Five API integration for offer autocomplete (server-only).
# FIVE_API_BASE_URL=
# FIVE_API_API_KEY=
# FIVE_API_TIMEOUT_SECONDS=10

# Optional: comma-separated frontend origins allowed by CORS.
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# Optional: logging level (default INFO).
# LOG_LEVEL=INFO
